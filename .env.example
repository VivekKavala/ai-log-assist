GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
# keyword | semantic | hybrid (default)
RETRIEVAL_MODE=hybrid
RETRIEVAL_MIN_SCORE=0.45
# Feedback storage (Supabase free tier). Optional: app works without it, but stats/feedback won't persist.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key
# Semantic cache: skip the LLM call for near-duplicate errors (cosine similarity threshold)
CACHE_SIMILARITY_THRESHOLD=0.93
